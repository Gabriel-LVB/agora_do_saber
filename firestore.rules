rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && (
          (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
          || request.auth.token.email == 'gabrielvieiraxc12@gmail.com'
        );
    }

    function emailInCourseList(data) {
      return signedIn()
        && request.auth.token.email is string
        && (
          (
            data.keys().hasAny(['courseEmails'])
            && data.courseEmails is list
            && request.auth.token.email in data.courseEmails
          )
          || (
            data.keys().hasAny(['course'])
            && data.course is list
            && request.auth.token.email in data.course
          )
          || (
            data.keys().hasAny(['emails'])
            && data.emails is list
            && request.auth.token.email in data.emails
          )
        );
    }

    function emailInSiteOnlyList(data) {
      return signedIn()
        && request.auth.token.email is string
        && (
          (
            data.keys().hasAny(['siteOnlyEmails'])
            && data.siteOnlyEmails is list
            && request.auth.token.email in data.siteOnlyEmails
          )
          || (
            data.keys().hasAny(['appEmails'])
            && data.appEmails is list
            && request.auth.token.email in data.appEmails
          )
          || (
            data.keys().hasAny(['noCourseEmails'])
            && data.noCourseEmails is list
            && request.auth.token.email in data.noCourseEmails
          )
        );
    }

    function hasCourseAccess() {
      return isAdmin()
        || (
          exists(/databases/$(database)/documents/config/access_whitelist)
          && emailInCourseList(
            get(/databases/$(database)/documents/config/access_whitelist).data
          )
        )
        || (
          exists(/databases/$(database)/documents/config/videoaulas_whitelist)
          && emailInCourseList(
            get(/databases/$(database)/documents/config/videoaulas_whitelist).data
          )
        );
    }

    function ownsIncomingData() {
      return signedIn()
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /config/{docId} {
      // O cliente precisa ler estas listas para descobrir sua própria modalidade
      // de acesso. Os demais documentos de configuração pertencem ao curso.
      allow read: if isAdmin()
        || (
          signedIn()
          && docId == 'site_ui'
        )
        || (
          signedIn()
          && docId == 'access_whitelist'
          && (
            emailInCourseList(resource.data)
            || emailInSiteOnlyList(resource.data)
          )
        )
        || (
          signedIn()
          && docId == 'videoaulas_whitelist'
          && emailInCourseList(resource.data)
        )
        || hasCourseAccess();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if hasCourseAccess();
      allow write: if isAdmin();
    }

    match /cronograma/{weekId} {
      allow read: if hasCourseAccess();
      allow write: if isAdmin();
    }

    match /shared_library/{itemId} {
      allow read: if isAdmin() || (hasCourseAccess() && resource.data.published == true);
      allow write: if isAdmin();

      match /chunks/{chunkId} {
        allow read: if isAdmin()
          || (
            hasCourseAccess()
            && get(/databases/$(database)/documents/shared_library/$(itemId)).data.published == true
          );
        allow write: if isAdmin();
      }

      // A curadoria completa permanece interna. O aluno recebe somente o snapshot
      // compacto learningSelection publicado no documento pai da aula.
      match /metadata_chunks/{chunkId} {
        allow read, write: if isAdmin();
      }
    }

    match /famed_content/{lessonId} {
      allow read: if isAdmin() || (hasCourseAccess() && resource.data.published == true);
      allow write: if isAdmin();
    }

    // Imagens das questões antigas FAMED. O documento acompanha o estado
    // publicado do conteúdo pai; gravação e remoção continuam exclusivas do admin.
    match /famed_assets/{assetId} {
      allow read: if isAdmin() || (hasCourseAccess() && resource.data.published == true);
      allow write: if isAdmin();
    }

    match /access_logs/{logId} {
      allow create, update: if ownsIncomingData() || isAdmin();
      allow read, delete: if isAdmin();
    }

    match /user_devices/{deviceId} {
      allow create, update: if ownsIncomingData() || isAdmin();
      allow read, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
